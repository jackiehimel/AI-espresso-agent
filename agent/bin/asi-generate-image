#!/usr/bin/env python3
"""
asi-generate-image — JSON CLI for AI Espresso illustrations.

Contract (one argv: JSON string):
  {
    "prompt": "...",
    "filename": "/abs/path/no/extension",
    "aspect_ratio": "16:9" | "1:1",
    "model": "nano_banana_2"
  }

Writes {filename}.png and exits 0 on success.

Backend: Gemini image models only, with a two-model chain:
  1. GEMINI_IMAGE_MODEL (default gemini-3.1-flash-image-preview, Nano Banana 2)
  2. GEMINI_IMAGE_FALLBACK_MODEL (default gemini-2.5-flash-image, stable tier —
     separate capacity pool, so peak-hour 503s on the preview model don't sink a run)

Each model gets up to 3 attempts with exponential backoff on transient errors
(503/UNAVAILABLE, timeouts, rate limits, empty responses). Auth/config errors
fail fast.
"""
from __future__ import annotations

import base64
import json
import os
import random
import sys
import time
from pathlib import Path

MIN_IMAGE_BYTES = 10_000
RETRY_ATTEMPTS = 3
RETRY_BASE_DELAY_SEC = 4.0

# Substrings (lowercased) of errors worth retrying. Everything else — bad key,
# invalid argument, permission denied — fails fast so misconfig is loud.
_RETRYABLE_MARKERS = (
    "503", "unavailable", "overloaded", "high demand",
    "timeout", "timed out", "deadline",
    "429", "resource_exhausted", "rate limit",
    "500", "internal",
    "no image part", "image too small",
)

# Deny-list checked first: Gemini reports depleted prepay credits as 429
# RESOURCE_EXHAUSTED, but no amount of retrying fixes a billing problem.
_NON_RETRYABLE_MARKERS = ("credit", "prepay", "billing", "api key")


def _is_retryable(exc: Exception) -> bool:
    msg = str(exc).lower()
    if any(m in msg for m in _NON_RETRYABLE_MARKERS):
        return False
    return any(m in msg for m in _RETRYABLE_MARKERS)


def _configure_stdio_utf8() -> None:
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if callable(reconfigure):
            reconfigure(encoding="utf-8", errors="replace")


def _normalize_prompt(prompt: str) -> str:
    for src, dst in (
        ("‘", "'"), ("’", "'"),
        ("“", '"'), ("”", '"'),
        ("—", " - "), ("–", "-"),
        ("…", "..."),
    ):
        prompt = prompt.replace(src, dst)
    return prompt


def _size_gemini(aspect_ratio: str) -> str:
    return "16:9" if aspect_ratio == "16:9" else "1:1"


def _default_models() -> tuple[str, str]:
    primary = os.environ.get("GEMINI_IMAGE_MODEL", "gemini-3.1-flash-image-preview")
    stable = os.environ.get("GEMINI_IMAGE_FALLBACK_MODEL", "gemini-2.5-flash-image")
    return primary, stable


def _extract_image_bytes(response) -> bytes:
    # response.parts is None when Gemini returns no candidates (safety block,
    # empty response) — killed the 2026-07-25 run; treat as retryable.
    for part in (response.parts or []):
        inline = part.inline_data
        if inline is None:
            continue
        raw = inline.data
        if raw is None:
            continue
        if isinstance(raw, str):
            raw = base64.b64decode(raw)
        return raw
    raise RuntimeError("Gemini returned no image part")


def _generate_gemini(prompt: str, out_path: Path, aspect_ratio: str, model: str | None = None) -> None:
    from google import genai
    from google.genai import types

    api_key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")
    if not api_key:
        raise RuntimeError("GEMINI_API_KEY not set")
    client = genai.Client(api_key=api_key)
    model = model or _default_models()[0]
    response = client.models.generate_content(
        model=model,
        contents=[prompt[:8000]],
        config=types.GenerateContentConfig(
            response_modalities=["IMAGE"],
            image_config=types.ImageConfig(
                aspect_ratio=_size_gemini(aspect_ratio),
                image_size="1K",
            ),
        ),
    )
    raw = _extract_image_bytes(response)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_bytes(raw)


def _generate_with_retries(
    prompt: str,
    out_path: Path,
    aspect_ratio: str,
    model: str,
    *,
    attempts: int = RETRY_ATTEMPTS,
    base_delay: float = RETRY_BASE_DELAY_SEC,
    sleep_fn=time.sleep,
    generate_fn=None,
) -> None:
    gen = generate_fn or _generate_gemini
    for attempt in range(1, attempts + 1):
        try:
            gen(prompt, out_path, aspect_ratio, model)
            if out_path.is_file() and out_path.stat().st_size > MIN_IMAGE_BYTES:
                return
            raise RuntimeError("image too small")
        except Exception as e:
            if attempt == attempts or not _is_retryable(e):
                raise
            delay = base_delay * (2 ** (attempt - 1)) * (1.0 + random.random() * 0.5)
            print(
                f"  [retry {attempt}/{attempts - 1}] {model}: "
                f"{str(e)[:200]}; retrying in {delay:.0f}s",
                file=sys.stderr,
            )
            sleep_fn(delay)


def _run_chain(
    prompt: str,
    out_path: Path,
    aspect_ratio: str,
    *,
    models: tuple[str, str] | None = None,
    **retry_kwargs,
) -> tuple[bool, str, list[str]]:
    """Try primary model (with retries), then the stable fallback model.

    Returns (ok, model_used, errors).
    """
    primary, stable = models or _default_models()
    chain = [primary]
    if stable and stable != primary:
        chain.append(stable)
    errors: list[str] = []
    for i, model in enumerate(chain):
        try:
            _generate_with_retries(prompt, out_path, aspect_ratio, model, **retry_kwargs)
            return True, model, errors
        except Exception as e:
            msg = str(e).replace("\n", " ")[:500]
            errors.append(f"{model}: {msg}")
            if i + 1 < len(chain):
                print(f"  [{model} failed, trying {chain[i + 1]}] {msg}", file=sys.stderr)
    return False, "", errors


def main() -> int:
    _configure_stdio_utf8()
    if len(sys.argv) < 2:
        print("usage: asi-generate-image '<json>'", file=sys.stderr)
        return 2
    req = json.loads(sys.argv[1])
    prompt = _normalize_prompt((req.get("prompt") or "").strip())
    if not prompt:
        print("missing prompt", file=sys.stderr)
        return 1
    stem = Path(req["filename"])
    aspect_ratio = req.get("aspect_ratio") or "16:9"
    out_path = Path(str(stem) + ".png")

    if not (os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY")):
        print("GEMINI_API_KEY not set", file=sys.stderr)
        return 1

    ok, model_used, errors = _run_chain(prompt, out_path, aspect_ratio)
    if ok:
        print(f"backend: gemini [{model_used}]", file=sys.stderr)
        if model_used != _default_models()[0]:
            # Surfaces as a GitHub Actions annotation so a struggling primary
            # model is visible the same day, not after a month of silence.
            print(
                f"::warning::illustration fell back to {model_used} "
                f"({'; '.join(errors)[:200]})",
                file=sys.stderr,
            )
        return 0
    print("; ".join(errors) or "image generation failed", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
